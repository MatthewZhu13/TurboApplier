# Copy to .env and fill in. Never commit .env.
NOTION_TOKEN=ntn_xxx            # Notion internal integration secret (share the Jobbot page with it)
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional phone push via https://ntfy.sh (pick an unguessable topic name)
NTFY_TOPIC=
# Safety switches
AUTO_SUBMIT=false               # false = fill + audit, then stop before submit (dry run)
MAX_SUBMITS_PER_DAY=15
